# --- MONGODB ---
# replicaSet=rs0: Node.js'e bunun bir kopya seti olduğunu söyler.
# directConnection=true: Tek bir node olduğu için doğrudan bağlanmasını sağlar.
MONGO_URI=mongodb://127.0.0.1:27017/nolbir_db?replicaSet=rs0&directConnection=true

# --- REDIS ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- INFLUXDB ---
