# --- SİSTEM KAYIT (REGISTRY) YOLLARI ---
# Not: Proje klasör yapına göre bu yolları güncelleyebilirsin.
REGISTRY_ROOT=C:/Users/User/Desktop/com/shared/registry

POSTGRESQL_PATH=${REGISTRY_ROOT}/postgres/init.sql
MONGODB_PATH=${REGISTRY_ROOT}/mongodb/collections.json
INFLUXDB_PATH=${REGISTRY_ROOT}/influxdb/buckets.json
RABBITMQ_CONFIG_PATH=${REGISTRY_ROOT}/rabbitmq/queues.json
MQTT_CONFIG_PATH=${REGISTRY_ROOT}/mqtt/topics.json
MINIO_CONFIG_PATH=${REGISTRY_ROOT}/minio/buckets.json
NEO4J_CONFIG_PATH=${REGISTRY_ROOT}/neo4j/schema.json

# --- ENUM REGISTRY (Node.js + Python FastAPI ORTAK KAYNAK) ---
# SQL şemasındaki smallint enum kolonlarının string karşılıklarını tutan tek
# doğruluk kaynağı. Node.js (enums/definitions.js, columnMap.js, licenseTypes.js)
# VE Python FastAPI (enums/definitions.py, column_map.py, license_types.py)
# İKİSİ DE aynı üç JSON dosyasını okur — enum eklemek/değiştirmek için sadece
# buradaki dosyalar güncellenir, iki dilde ayrı ayrı kod değişikliği gerekmez.
ENUM_DEFINITIONS_PATH=${REGISTRY_ROOT}/enums/definitions.json
ENUM_COLUMN_MAP_PATH=${REGISTRY_ROOT}/enums/columnMap.json
ENUM_LICENSE_TYPES_PATH=${REGISTRY_ROOT}/enums/licenseTypes.json
ENUM_CATEGORY_CODES_PATH=${REGISTRY_ROOT}/enums/categoryCodes.json

CLAMAV_HOST=clamav_nolbir
CLAMAV_PORT=3310

GENESIS_JSON_PATH=C:/Users/User/Desktop/com/nodejs_nolbir/genesis.json

