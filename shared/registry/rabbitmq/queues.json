{
  "version": 3,
  "vhost": "/",
  "retry": {
    "ttlMs": 30000,
    "maxAttempts": 5
  },
  "exchanges": [
    {
      "name": "nolbir.sync",
      "type": "topic",
      "durable": true
    },
    {
      "name": "nolbir.retry",
      "type": "direct",
      "durable": true
    }
  ],
  "targets": [
    "mongodb",
    "neo4j",
    "redis",
    "influxdb"
  ],
  "perTarget": {
    "queue": {
      "name": "sync.<t>",
      "durable": true,
      "args": {
        "x-dead-letter-exchange": "nolbir.retry",
        "x-dead-letter-routing-key": "sync.<t>.retry"
      },
      "binding": {
        "exchange": "nolbir.sync",
        "routingKey": "<t>.#"
      }
    },
    "retryQueue": {
      "name": "sync.<t>.retry",
      "durable": true,
      "args": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "sync.<t>"
      },
      "binding": {
        "exchange": "nolbir.retry",
        "routingKey": "sync.<t>.retry"
      }
    },
    "dlq": {
      "name": "sync.<t>.dlq",
      "durable": true,
      "args": {},
      "note": "Elle incelenir, tüketici yok."
    }
  },
  "routingKey": "<sync_target adı küçük harf>.<tablo>.<data_operation adı küçük harf>",
  "messageHeaders": [
    "outboxId",
    "aggregateType",
    "aggregateId",
    "operation",
    "occurredAt"
  ],
  "workTargets": [
    {
      "name": "media_scan",
      "queue": "work.media_scan",
      "binding": "media_scan.media_assets.insert"
    },
    {
      "name": "media_transcode",
      "queue": "work.media_transcode",
      "binding": "media_transcode.media_assets.insert"
    },
    {
      "name": "ai_analysis",
      "queue": "work.ai_analysis",
      "bindings": [
        "ai_analysis.approvals.insert",
        "ai_analysis.complaints.insert"
      ]
    }
  ]
}