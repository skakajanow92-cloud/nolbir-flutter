          "name": "uq_user_profiles_userId",
          "key": {
            "userId": 1
          },
          "unique": true
        },
        {
          "name": "uq_user_profiles_email",
          "key": {
            "email": 1
          },
          "unique": true,
          "collation": {
            "locale": "en",
            "strength": 2
          }
        },
        {
          "name": "ix_user_profiles_userName",
          "key": {
            "userName": 1
          },
          "sparse": true,
          "collation": {
            "locale": "en",
            "strength": 2
          }
        }
      ]
